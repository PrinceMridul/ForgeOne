# ForgeOne Environment Configuration
DATABASE_URL="postgresql://forgeone:forgeone@localhost:5432/forgeone?schema=public"
REDIS_URL="redis://localhost:6379"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="replace-me"
S3_SECRET_KEY="replace-me"
S3_BUCKET="forgeone-artifacts"
S3_REGION="us-east-1"
JWT_SECRET="change-me-in-production-use-openssl-rand-base64-64"
JWT_ISSUER="forgeone"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
API_HOST="0.0.0.0"
API_PORT=4000
API_LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:8080,http://localhost:5173,http://localhost:3000"
AGENT_RUNTIME_HOST="0.0.0.0"
AGENT_RUNTIME_PORT=8000
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
DEFAULT_LLM_PROVIDER="openai"
DEFAULT_LLM_MODEL="gpt-4o"
AGENT_MAX_ITERATIONS=50
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_TOKENS_PER_RUN=100000
# Web app (apps/web, TanStack Start + Vite).
# Leave VITE_API_URL empty in development: the Vite dev server proxies
# /api/v1 and /health to the API on :4000, so the browser stays same-origin.
# Set it to the deployed API origin in production.
VITE_API_URL=""

# Live execution pacing (apps/api).
# The orchestration pipeline is CPU-only and finishes in ~8ms, which is faster
# than the UI can poll. These meter how quickly already-computed telemetry is
# released so the console streams in real time. Defaults give a ~40s run.
# Set RUN_PACING=off to restore instant completion.
RUN_EVENT_PACING_MS=240
RUN_STAGE_PACING_MS=900
SANDBOX_IMAGE="forgeone/sandbox:latest"
SANDBOX_MEMORY_LIMIT="512m"
SANDBOX_CPU_LIMIT="1.0"
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_NETWORK_ENABLED=false
