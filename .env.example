# ForgeOne environment configuration
#
# Every setting here has a working default in apps/api/src/config.ts, so no
# .env file is required to run or deploy ForgeOne. Copy this file only when you
# want to change something.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Model providers — optional
# ---------------------------------------------------------------------------
# Set any one key to have the Product Manager and Developer agents call a real
# model. With none set they use the deterministic generator, and each agent
# says so in its own telemetry during the run.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Force a provider instead of auto-detecting from the keys above.
# One of: openai | anthropic | gemini | mock
DEFAULT_LLM_PROVIDER=""

# ---------------------------------------------------------------------------
# Live execution pacing (apps/api)
# ---------------------------------------------------------------------------
# The pipeline is CPU-only and finishes in ~8ms — faster than the console can
# poll. These meter how fast already-computed telemetry is released so a run
# streams agent by agent. Work is never slowed, only event emission.
# Defaults give a ~42 second run. Disabled automatically under NODE_ENV=test.
RUN_EVENT_PACING_MS=130
RUN_STAGE_PACING_MS=900
# RUN_PACING=off        # restore instant completion

# ---------------------------------------------------------------------------
# API server (apps/api)
# ---------------------------------------------------------------------------
API_HOST="0.0.0.0"
API_PORT=4000
API_LOG_LEVEL="info"

# Comma-separated allowed origins. Only consulted when the browser talks to the
# API cross-origin. In development the Vite proxy and in production the SSR
# reverse proxy both keep the browser same-origin, so this normally goes unused.
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:8080"

# ---------------------------------------------------------------------------
# Web app (apps/web) and the production supervisor
# ---------------------------------------------------------------------------
# Leave VITE_API_URL empty. The browser calls /api/v1 on its own origin; Vite
# proxies it in development and apps/web/src/lib/api-proxy.ts proxies it in
# production. Setting it points the browser at a cross-origin API and
# reintroduces the CORS surface the proxy exists to remove.
VITE_API_URL=""

# Public port bound by scripts/start-production.mjs.
PORT=8080

# ---------------------------------------------------------------------------
# Not used by the running demo
# ---------------------------------------------------------------------------
# Run state is held in memory. These configure packages/database and the
# docker-compose services, which are scaffolded but not wired into the
# execution path — see the Limitations section of README.md.
# DATABASE_URL="postgresql://forgeone:forgeone@localhost:5432/forgeone?schema=public"
# REDIS_URL="redis://localhost:6379"
# AGENT_RUNTIME_URL="http://localhost:8000"
# JWT_SECRET="change-me-in-production-use-openssl-rand-base64-64"
